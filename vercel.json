{
  "headers": [
    {
      "source": "/lp/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/ad-sizes",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/ad-sizes/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/media-kit/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/tools/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/lp/proposals/:token",
      "destination": "/lp/proposals/:token/index.html"
    },
    {
      "source": "/lp/reports/:token",
      "destination": "/lp/reports/:token/index.html"
    },
    {
      "source": "/lp/review/:token",
      "destination": "/lp/review/:token/index.html"
    },
    {
      "source": "/media-kit/:brand",
      "destination": "/media-kit/:brand/index.html"
    },
    {
      "source": "/tools/:tool",
      "destination": "/tools/:tool/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
